@model List<Menu.Models.Product>

@{
    ViewData["Title"] = $"Search Results for '{ViewBag.SearchQuery}'";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/SearchResult.css" asp-append-version="true" />
<div class="search-results-container">
    <div class="search-header">
        <h2>Search Results</h2>
        <p class="search-info">
            @if (ViewBag.ResultCount > 0)
            {
                <span>Found @ViewBag.ResultCount result(s) for "<strong>@ViewBag.SearchQuery</strong>"</span>
            }
            else
            {
                <span>No results found for "<strong>@ViewBag.SearchQuery</strong>"</span>
            }
        </p>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i>
            Error: @ViewBag.Error
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="products-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <div class="product-image">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="no-image">
                                <i class="fas fa-utensils"></i>
                            </div>
                        }
                    </div>
                    <div class="product-info">
                        <h3 class="product-name">@product.Name</h3>
                        <p class="product-description">@product.Description</p>
                        <div class="product-meta">
                            <span class="product-category">@product.Category</span>
                            <span class="product-price">$@product.Price.ToString("F2")</span>
                        </div>
                        <button onclick="addToOrder('@product.Id', '@product.Name', @product.Price)"
                                class="btn btn-primary add-to-order-btn">
                            <i class="fas fa-plus"></i> Add to Order
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else if (ViewBag.ResultCount == 0)
    {
        <div class="no-results">
            <div class="no-results-icon">
                <i class="fas fa-search"></i>
            </div>
            <h3>No items found</h3>
            <p>Try searching with different keywords or browse our menu categories.</p>
            <div class="suggestions">
                <h4>Popular categories:</h4>
                <div class="category-links">
                    <a href="@Url.Action("Pizza", "Menu")" class="btn btn-outline">Pizza</a>
                    <a href="@Url.Action("Pasta", "Menu")" class="btn btn-outline">Pasta</a>
                    <a href="@Url.Action("Burgers", "Menu")" class="btn btn-outline">Burgers</a>
                    <a href="@Url.Action("Beverages", "Menu")" class="btn btn-outline">Beverages</a>
                </div>
            </div>
        </div>
    }
</div>


