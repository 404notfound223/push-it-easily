@{
    ViewData["Title"] = "Your Order";
    var userRole = Context.Session.GetString("UserRole") ?? "guest";
}

<link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
<!-- Add meta tag to pass user role to JavaScript -->
<meta name="user-role" content="@userRole" />

<link rel="stylesheet" href="~/css/ViewOrders.css" asp-append-version="true" />
<div class="order-page">
    <div class="order-header">
        <h2>Your Order</h2>
        <button onclick="clearOrder()" class="btn btn-outline-danger btn-sm">Clear All</button>
    </div>

    <div class="order-content">
        <div id="order-list" class="order-items-container">
            <!-- Order items will be populated by JavaScript -->
        </div>

        <div class="empty-order-message" id="empty-order" style="display: none;">
            <div class="empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <h3>Your cart is empty</h3>
                <p>Add some delicious items from our menu to get started!</p>
                <button onclick="window.location.href='/Menu/All'" class="btn btn-primary">Browse Menu</button>
            </div>
        </div>
    </div>

    <div id="order-summary" class="order-summary" style="display: none;">
        <div class="summary-content">
            <div class="summary-row">
                <span>Subtotal:</span>
                <span id="order-subtotal">$0.00</span>
            </div>
            <!-- Added member discount display row -->
            <div class="summary-row member-discount-row" id="member-discount-row" style="display: none;">
                <span>Member Discount (10%):</span>
                <span id="member-discount" class="discount-amount">-$0.00</span>
            </div>
            <div class="summary-row">
                <span>Tax (8.5%):</span>
                <span id="order-tax">$0.00</span>
            </div>
            <div class="summary-row total-row">
                <span>Total:</span>
                <span id="order-total">$0.00</span>
            </div>
            <button id="checkout-button" class="btn btn-success btn-lg payment-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
                Make Payment
            </button>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="payment-modal" class="modal" style="display: none;">
        <div class="payment-modal-content">
            <span class="close" onclick="closePaymentModal()">&times;</span>
            <div class="payment-summary">
                <div class="summary-row">
                    <span>Subtotal:</span>
                    <span id="modal-subtotal">$0.00</span>
                </div>
                <!-- Added member discount display in payment modal -->
                <div class="summary-row member-discount-row" id="modal-member-discount-row" style="display: none;">
                    <span>Member Discount (10%):</span>
                    <span id="modal-member-discount" class="discount-amount">-$0.00</span>
                </div>
                <div class="summary-row">
                    <span>Tax (8.5%):</span>
                    <span id="modal-tax">$0.00</span>
                </div>
                <div class="summary-row total-row">
                    <span>Total:</span>
                    <span id="modal-total">$0.00</span>
                </div>
            </div>
            <div class="payment-options">
                <button class="payment-option-btn" onclick="processOnlinePayment()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 4h22v16H1V4zm2 2v14h20V6H3zm18 14H5V8h18v12zm-1-6h-2v2h2v-2zm-4 0h-2v2h2v-2zm-4 0h-2v2h2v-2z"></path>
                    </svg>
                    <div>
                        <strong>Pay Online</strong>
                        <small>Secure payment via Stripe</small>
                    </div>
                </button>
                <button class="payment-option-btn" onclick="processCounterPayment()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 4h22v16H1V4zm2 2v14h20V6H3zm18 14H5V8h18v12zm-1-6h-2v2h2v-2zm-4 0h-2v2h2v-2zm-4 0h-2v2h2v-2z"></path>
                    </svg>
                    <div>
                        <strong>Pay at Counter</strong>
                        <small>Pay with cash or card</small>
                    </div>
                </button>
            </div>
            <button class="cancel-btn" onclick="closePaymentModal()">Cancel</button>
        </div>
    </div>

    <!-- Notification -->
    <div id="notification" class="notification" style="display: none;">
        <div class="notification-content">
            <span id="notification-message"></span>
            <button class="notification-close" onclick="closeNotification()">&times;</button>
        </div>
    </div>
</div>

<script src="~/js/order.js"></script>
<script src="https://js.stripe.com/v3/"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        renderOrder();
        document.getElementById("checkout-button").addEventListener("click", function() {
            const order = JSON.parse(localStorage.getItem("orderItems")) || [];
            if (order.length === 0) {
                showNotification("Your cart is empty.", "error");
                return;
            }
            showPaymentOptions();
        });
    });
</script>
