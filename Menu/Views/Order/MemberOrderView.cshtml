@model Menu.Models.Order

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/order.css" />
@* <link rel="stylesheet" href="~/css/order.css" asp-append-version="true" /> *@
<div class="order-details-page">
    <div class="page-header">
        <h1>
            <i class="fas fa-receipt me-2"></i>Order Details
        </h1>
    </div>

    <div class="order-details-container">
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="error-message">
                <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
            </div>
        }
        else if (Model != null)
        {
            <!-- Replaced Bootstrap card with order-summary-card from order.css -->
            <div class="order-summary-card">
                <div class="order-header">
                    <div class="order-number">
                        <h2>Order #@Model.OrderId</h2>
                        <p class="order-date">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(Model.Status == "Paid" ? "bg-success" : Model.Status == "Pending Payment" ? "bg-warning" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </p>
                    </div>
                    <div class="customer-info">
                        <h3>Customer Information</h3>
                        @if (Model.User != null)
                        {
                            <p><strong>Name:</strong> @Model.User.Name</p>
                            <p><strong>Email:</strong> @Model.User.Email</p>
                            <p><strong>Member ID:</strong> @Model.User.UserId</p>
                        }
                        else
                        {
                            <p><em>Guest Order</em></p>
                        }
                    </div>
                </div>
            </div>

            <!-- Replaced Bootstrap table with order-items-card and item-row structure -->
            <div class="order-items-card">
                <h3>Order Items</h3>
                @foreach (var detail in Model.OrderDetails)
                {
                    <div class="item-row">
                        <div class="item-info">
                            <h4>@detail.Product.Name</h4>
                            @if (!string.IsNullOrEmpty(detail.Product.Description))
                            {
                                <div class="item-description">@detail.Product.Description</div>
                            }
                        </div>
                        <div class="item-quantity">
                            <span class="quantity-label">Qty</span>
                            <span class="quantity-value">@detail.Quantity</span>
                        </div>
                        <div class="item-pricing">
                            <p class="unit-price">RM @detail.UnitPrice.ToString("F2") each</p>
                            <p class="total-price">RM @((detail.UnitPrice * detail.Quantity).ToString("F2"))</p>
                        </div>
                    </div>
                }

                <!-- Replaced Bootstrap card summary with order-totals structure -->
                <div class="order-totals">
                    <div class="totals-row">
                        <span>Subtotal:</span>
                        <span>RM @ViewBag.Subtotal?.ToString("F2")</span>
                    </div>
                    <div class="totals-row">
                        <span>Tax (8.5%):</span>
                        <span>RM @ViewBag.Tax?.ToString("F2")</span>
                    </div>
                    @if (ViewBag.MemberDiscount != null && (decimal)ViewBag.MemberDiscount > 0)
                    {
                        <div class="totals-row" style="color: #28a745;">
                            <span><strong>Member Discount (10%):</strong></span>
                            <span><strong>-RM @ViewBag.MemberDiscount?.ToString("F2")</strong></span>
                        </div>
                    }
                    <div class="totals-row total-row">
                        <span>Total Amount:</span>
                        <span>RM @Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <!-- Replaced Bootstrap button group with order-actions-card -->
            <div class="order-actions-card">
                <a href="@Url.Action("OrderHistory", "Order")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Order History
                </a>
                <button onclick="window.print()" class="btn btn-primary">
                    <i class="fas fa-print me-2"></i>Print Order
                </button>
            </div>
        }
        else
        {
            <div class="error-message">
                <i class="fas fa-exclamation-triangle me-2"></i>Order not found.
            </div>
        }
    </div>
</div>

