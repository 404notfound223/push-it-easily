@model Menu.Models.Order
@{
    ViewData["Title"] = $"Receipt - Order #{Model.OrderId.Substring(0, 8).ToUpper()}";
    Layout = null; // No layout for clean printing
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
</head>
<body>
    <!-- Screen-only print actions -->
    <div class="print-actions no-print">
        <button onclick="window.print()" class="btn btn-primary">Print Receipt</button>
        <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
    </div>

    <!-- Receipt Header -->
    <div class="receipt-header">
        <h1>THE SECRET RESTAURANT</h1>
        <p>123 Culinary Street</p>
        <p>Food District, KL 50000</p>
        <p>Tel: +60 3-1234 5678</p>
    </div>

    <!-- Receipt Info -->
    <div class="receipt-info">
        <p>Order #: @Model.OrderId.Substring(0, 8).ToUpper()</p>
        <p>Date: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        @if (Model.User != null)
        {
            <p>Customer: @Model.User.Name</p>
            @if (Model.User.Role.ToLower() == "member")
            {
                <p>Member ID: @Model.User.UserId</p>
            }
        }
        else
        {
            <p>Customer: Walk-in</p>
        }
        <p>Status: @Model.Status</p>
    </div>

    <!-- Items Section -->
    <div class="items-section">
        @foreach (var item in Model.OrderDetails)
        {
            <div class="item-row">
                <div class="item-name">@item.Product.Name</div>
                <div class="item-details">
                    <span>@item.Quantity x RM@item.UnitPrice.ToString("F2")</span>
                    <span>RM@((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                </div>
            </div>
        }
    </div>

    <!-- Totals Section -->
    <div class="totals-section">
        @{
            var subtotal = Model.OrderDetails.Sum(od => od.UnitPrice * od.Quantity);
            var tax = subtotal * 0.085m;
            var memberDiscount = 0m;

            if (Model.User?.Role?.ToLower() == "member")
            {
                memberDiscount = subtotal * 0.10m;
            }
        }

        <div class="total-row">
            <span>Subtotal:</span>
            <span>RM @subtotal.ToString("F2")</span>
        </div>

        @if (memberDiscount > 0)
        {
            <div class="total-row member-discount">
                <span>Member Discount:</span>
                <span>-RM @memberDiscount.ToString("F2")</span>
            </div>
        }

        <div class="total-row">
            <span>Tax (8.5%):</span>
            <span>RM @tax.ToString("F2")</span>
        </div>

        <div class="total-row final-total">
            <span>TOTAL:</span>
            <span>RM @Model.TotalAmount.ToString("F2")</span>
        </div>
    </div>

    <!-- Receipt Footer -->
    <div class="receipt-footer">
        <p>Thank you for your order!</p>
        <p>Please keep this receipt</p>
        <p>for your records</p>
        <p>--------------------------------</p>
        <p>Generated: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <script>
        // Auto-print when opened directly
        window.onload = function() {
            if (window.location.search.includes('autoprint=true')) {
                setTimeout(() => {
                    window.print();
                }, 500);
            }
        }
    </script>
</body>
</html>
