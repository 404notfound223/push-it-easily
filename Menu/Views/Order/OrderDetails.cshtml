@model Menu.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
<div class="order-details-page">
    <div class="page-header">
        <button onclick="window.history.back()" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15,18 9,12 15,6"></polyline>
            </svg>
            Back
        </button>
        <h1>Order Details</h1>
    </div>

    @if (Model != null)
    {
        <div class="order-details-container">
            <div class="order-summary-card">
                <div class="order-header">
                    <div class="order-number">
                        <h2>Order #@Model.OrderId.Substring(0, 8).ToUpper()</h2>
                        <p class="order-date">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                    </div>
                    <div class="order-status-section">
                        <span class="status-badge status-@Model.Status.ToLower().Replace(" ", "-")">@Model.Status</span>
                    </div>
                </div>

                <div class="customer-info">
                    <h3>Customer Information</h3>
                    @if (Model.User != null)
                    {
                        <p><strong>Name:</strong> @Model.User.Name</p>
                        <p><strong>Email:</strong> @Model.User.Email</p>
                        <p><strong>Member ID:</strong> @Model.User.UserId</p>
                    }
                    else
                    {
                        <p><em>Guest Order</em></p>
                    }
                </div>
            </div>

            <div class="order-items-card">
                <h3>Order Items</h3>
                <div class="items-list">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="item-row">
                            <div class="item-info">
                                <h4>@item.Product.Name</h4>
                                <p class="item-description">@item.Product.Description</p>
                                <p class="item-category">Category: @item.Product.Category</p>
                            </div>
                            <div class="item-quantity">
                                <span class="quantity-label">Qty:</span>
                                <span class="quantity-value">@item.Quantity</span>
                            </div>
                            <div class="item-pricing">
                                <p class="unit-price">$@item.UnitPrice.ToString("F2") each</p>
                                <p class="total-price">$@((item.UnitPrice * item.Quantity).ToString("F2"))</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="order-totals">
                    @{
                        var subtotal = Model.OrderDetails.Sum(od => od.UnitPrice * od.Quantity);
                        var tax = subtotal * 0.085m;
                        var memberDiscount = 0m;

                        if (Model.User?.Role == "member")
                        {
                            memberDiscount = (subtotal + tax) * 0.10m;
                        }
                    }

                    <div class="totals-row">
                        <span>Subtotal:</span>
                        <span>$@subtotal.ToString("F2")</span>
                    </div>
                    @if (memberDiscount > 0)
                    {
                        <div class="totals-row member-discount">
                            <span>Member Discount (10%):</span>
                            <span>-$@memberDiscount.ToString("F2")</span>
                        </div>
                    }
                    <div class="totals-row">
                        <span>Tax (8.5%):</span>
                        <span>$@tax.ToString("F2")</span>
                    </div>
                    <div class="totals-row total-row">
                        <span>Total:</span>
                        <span>$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <div class="order-actions-card">
                @if (Model.Status == "Completed")
                {
                    <button onclick="reorder()" class="btn btn-primary">Reorder These Items</button>
                }
                @if (Model.Status == "Pending" || Model.Status == "Preparing")
                {
                    <button onclick="trackOrder()" class="btn btn-info">Track Order Status</button>
                }
                <button onclick="printOrder()" class="btn btn-outline">Print Receipt</button>
            </div>
        </div>
    }
    else
    {
        <div class="error-message">
            <h3>Order not found</h3>
            <p>The requested order could not be found.</p>
            <button onclick="window.location.href='/Order/OrderHistory'" class="btn btn-primary">Back to Order History</button>
        </div>
    }
</div>

<script src="~/js/OrderDetail.js" defer></script>
