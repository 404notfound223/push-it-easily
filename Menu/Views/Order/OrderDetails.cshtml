@model Menu.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="order-details-page">
    <div class="page-header">
        <button onclick="window.history.back()" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15,18 9,12 15,6"></polyline>
            </svg>
            Back
        </button>
        <h1>Order Details</h1>
    </div>

    @if (Model != null)
    {
        <div class="order-details-container">
            <div class="order-summary-card">
                <div class="order-header">
                    <div class="order-number">
                        <h2>Order #@Model.OrderId.Substring(0, 8).ToUpper()</h2>
                        <p class="order-date">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                    </div>
                    <div class="order-status-section">
                        <span class="status-badge status-@Model.Status.ToLower().Replace(" ", "-")">@Model.Status</span>
                    </div>
                </div>
                
                <div class="customer-info">
                    <h3>Customer Information</h3>
                    <p><strong>Name:</strong> @Model.User.Name</p>
                    <p><strong>Email:</strong> @Model.User.Email</p>
                </div>
            </div>

            <div class="order-items-card">
                <h3>Order Items</h3>
                <div class="items-list">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="item-row">
                            <div class="item-info">
                                <h4>@item.Product.Name</h4>
                                <p class="item-description">@item.Product.Description</p>
                                <p class="item-category">Category: @item.Product.Category</p>
                            </div>
                            <div class="item-quantity">
                                <span class="quantity-label">Qty:</span>
                                <span class="quantity-value">@item.Quantity</span>
                            </div>
                            <div class="item-pricing">
                                <p class="unit-price">$@item.UnitPrice.ToString("F2") each</p>
                                <p class="total-price">$@((item.UnitPrice * item.Quantity).ToString("F2"))</p>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="order-totals">
                    <div class="totals-row">
                        <span>Subtotal:</span>
                        <span>$@((Model.TotalAmount / 1.085m).ToString("F2"))</span>
                    </div>
                    <div class="totals-row">
                        <span>Tax (8.5%):</span>
                        <span>$@((Model.TotalAmount - (Model.TotalAmount / 1.085m)).ToString("F2"))</span>
                    </div>
                    <div class="totals-row total-row">
                        <span>Total:</span>
                        <span>$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <div class="order-actions-card">
                @if (Model.Status == "Completed")
                {
                    <button onclick="reorder()" class="btn btn-primary">Reorder These Items</button>
                }
                @if (Model.Status == "Pending" || Model.Status == "Preparing")
                {
                    <button onclick="trackOrder()" class="btn btn-info">Track Order Status</button>
                }
                <button onclick="printOrder()" class="btn btn-outline">Print Receipt</button>
            </div>
        </div>
    }
    else
    {
        <div class="error-message">
            <h3>Order not found</h3>
            <p>The requested order could not be found.</p>
            <button onclick="window.location.href='/Order/OrderHistory'" class="btn btn-primary">Back to Order History</button>
        </div>
    }
</div>

<script>
    function reorder() {
        if (confirm('Add all items from this order to your current cart?')) {
            showNotification('Items added to cart!', 'success');
            // Implementation would add items to localStorage cart
        }
    }
    
    function trackOrder() {
        showNotification('Order tracking updates will be sent to your email.', 'info');
    }
    
    function printOrder() {
        window.print();
    }
    
    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.className = `notification ${type}`;
        notification.textContent = message;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.remove();
        }, 3000);
    }
</script>

<style>
    .order-details-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e9ecef;
    }
    
    .page-header h1 {
        margin: 0;
        color: #333;
    }
    
    .order-details-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .order-summary-card,
    .order-items-card,
    .order-actions-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 24px;
    }
    
    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }
    
    .order-number h2 {
        margin: 0 0 5px 0;
        color: #333;
    }
    
    .order-date {
        margin: 0;
        color: #6c757d;
    }
    
    .customer-info h3 {
        margin-bottom: 15px;
        color: #333;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 10px;
    }
    
    .customer-info p {
        margin: 8px 0;
    }
    
    .order-items-card h3 {
        margin-bottom: 20px;
        color: #333;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 10px;
    }
    
    .item-row {
        display: flex;
        align-items: center;
        padding: 20px 0;
        border-bottom: 1px solid #f8f9fa;
    }
    
    .item-row:last-child {
        border-bottom: none;
    }
    
    .item-info {
        flex: 1;
        margin-right: 20px;
    }
    
    .item-info h4 {
        margin: 0 0 5px 0;
        color: #333;
    }
    
    .item-description {
        margin: 5px 0;
        color: #6c757d;
        font-size: 0.9rem;
    }
    
    .item-category {
        margin: 5px 0 0 0;
        color: #6c757d;
        font-size: 0.8rem;
    }
    
    .item-quantity {
        text-align: center;
        margin-right: 20px;
    }
    
    .quantity-label {
        display: block;
        font-size: 0.8rem;
        color: #6c757d;
        margin-bottom: 5px;
    }
    
    .quantity-value {
        font-size: 1.2rem;
        font-weight: 600;
        color: #333;
    }
    
    .item-pricing {
        text-align: right;
        min-width: 120px;
    }
    
    .unit-price {
        margin: 0 0 5px 0;
        color: #6c757d;
        font-size: 0.9rem;
    }
    
    .total-price {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #28a745;
    }
    
    .order-totals {
        border-top: 2px solid #e9ecef;
        padding-top: 20px;
        margin-top: 20px;
    }
    
    .totals-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 1rem;
    }
    
    .total-row {
        border-top: 1px solid #e9ecef;
        padding-top: 15px;
        margin-top: 15px;
        font-size: 1.25rem;
        font-weight: bold;
        color: #333;
    }
    
    .order-actions-card {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .btn-info {
        background-color: #17a2b8;
        color: white;
    }
    
    .error-message {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    @media print {
        .page-header,
        .order-actions-card {
            display: none;
        }
        
        .order-details-page {
            max-width: none;
            padding: 0;
        }
    }
</style>
