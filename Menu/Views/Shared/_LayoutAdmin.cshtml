@{
    var role = Context.Session.GetString("UserRole") ?? "staff";
    var userName = Context.Session.GetString("UserName") ?? "Staff";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/staff.css" />
    <!-- Added OrderStatus CSS file for color-coded status styling -->
    <link rel="stylesheet" href="~/css/OrderStatus.css" />
</head>
<body>
    <header class="admin-header">
        <nav class="admin-nav">
            <div class="nav-left">
                <div class="admin-logo">
                    Staff Management
                </div>

                <ul class="nav-links">
                    <li><a href="#" onclick="showTab('orders', event)" class="tab-button">Order Management</a></li>
                    @if (role.ToLower() == "admin")
                    {
                        <li><a href="#" onclick="showTab('users', event)" class="tab-button">User Management</a></li>
                    }
                    <li><a href="#" onclick="showTab('products', event)" class="tab-button">Product Management</a></li>
                    <!-- Removed Category Management from toolbar as requested -->
                </ul>
            </div>

            <div class="nav-right">
                <div class="user-info">
                    <div class="user-avatar">@userName.Substring(0, 1).ToUpper()</div>
                    <div>
                        <div style="font-weight: 500;">@userName</div>
                        <div style="font-size: 0.8rem; opacity: 0.8;">@role.ToUpper()</div>
                    </div>
                </div>

                <button onclick="window.history.back()" class="btn-return" title="Go Back">
                    &larr; Back
                </button>

                <button onclick="logout()" class="btn btn-logout" title="Logout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16,17 21,12 16,7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Logout
                </button>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content">
        <div class="management-container">
            <!-- ---------------- ORDER MANAGEMENT TAB ---------------- -->
            <div id="orders-tab" class="tab-content active">
                <div class="section-header">
                    <h3>Order Management</h3>
                    <div class="order-controls">
                        <!-- Added search functionality for orders -->
                        <div class="search-controls">
                            <input type="text" id="orderSearch" placeholder="Search orders..." onkeyup="searchOrders()" />
                        </div>
                        <div class="filter-controls">
                            <select id="statusFilter" onchange="loadOrders()">
                                <option value="all">All Status</option>
                                <option value="Pending">Pending</option>
                                <option value="Preparing">Preparing</option>
                                <option value="Ready">Ready</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>

                            <select id="orderSortBy" onchange="loadOrders()">
                                <option value="date">Sort by Date</option>
                                <option value="status">Sort by Status</option>
                                <option value="customer">Sort by Customer</option>
                                <option value="total">Sort by Total</option>
                            </select>

                            <select id="orderSortOrder" onchange="loadOrders()">
                                <option value="desc">Newest First</option>
                                <option value="asc">Oldest First</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="orders-table-body">
                            <!-- Orders will be loaded via AJAX -->
                        </tbody>
                    </table>

                    <div class="pagination-container">
                        <div class="pagination-info">
                            <span id="order-pagination-info">Loading...</span>
                        </div>
                        <div class="pagination-controls">
                            <button id="order-prev-page" onclick="changeOrderPage(-1)" disabled>Previous</button>
                            <span id="order-page-numbers"></span>
                            <button id="order-next-page" onclick="changeOrderPage(1)" disabled>Next</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ---------------- USER MANAGEMENT TAB ---------------- -->
            @if (role.ToLower() == "admin")
            {
                <div id="users-tab" class="tab-content">
                    <div class="section-header">
                        <h3>User Management</h3>
                        <div class="user-controls">
                            <!-- Added search functionality for users -->
                            <div class="search-controls">
                                <input type="text" id="userSearch" placeholder="Search users..." onkeyup="searchUsers()" />
                            </div>
                            <div class="filter-controls">
                                <select id="roleFilter" onchange="loadUsers()">
                                    <option value="all">All Roles</option>
                                    <option value="member">Members</option>
                                    <option value="staff">Staff</option>
                                    <option value="admin">Admins</option>
                                </select>

                                <select id="userSortBy" onchange="loadUsers()">
                                    <option value="name">Sort by Name</option>
                                    <option value="email">Sort by Email</option>
                                    <option value="role">Sort by Role</option>
                                </select>

                                <select id="userSortOrder" onchange="loadUsers()">
                                    <option value="asc">A-Z</option>
                                    <option value="desc">Z-A</option>
                                </select>
                            </div>

                            <button class="btn btn-primary" onclick="showAddUserPanel()">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Add New User
                            </button>
                        </div>
                    </div>

                    <div class="table-container">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="users-table-body">
                                <!-- Users will be loaded via AJAX -->
                            </tbody>
                        </table>

                        <div class="pagination-container">
                            <div class="pagination-info">
                                <span id="user-pagination-info">Loading...</span>
                            </div>
                            <div class="pagination-controls">
                                <button id="user-prev-page" onclick="changeUserPage(-1)" disabled>Previous</button>
                                <span id="user-page-numbers"></span>
                                <button id="user-next-page" onclick="changeUserPage(1)" disabled>Next</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- ---------------- PRODUCT MANAGEMENT TAB ---------------- -->
            <div id="csrfTokenContainer" style="display:none;">
                @Html.AntiForgeryToken()
            </div>

            <div id="products-tab" class="tab-content">
                <div class="section-header">
                    <h3>Product Management</h3>
                    <div class="product-controls">
                        <!-- Added search functionality for products -->
                        <div class="search-controls">
                            <input type="text" id="productSearch" placeholder="Search products..." onkeyup="searchProducts()" />
                        </div>
                        <div class="filter-controls">
                            <select id="categoryFilter" onchange="loadProducts()">
                                <option value="all">All Categories</option>
                                <option value="Pizza">Pizza</option>
                                <option value="Pasta">Pasta</option>
                                <option value="Seafood">Seafood</option>
                                <option value="Burgers">Burgers</option>
                                <option value="Beverages">Beverages</option>
                                <option value="Desserts">Desserts</option>
                                <option value="Specials">Specials</option>
                            </select>

                            <select id="sortBy" onchange="loadProducts()">
                                <option value="name">Sort by Name</option>
                                <option value="category">Sort by Category</option>
                                <option value="price">Sort by Price</option>
                            </select>

                            <select id="sortOrder" onchange="loadProducts()">
                                <option value="asc">Ascending</option>
                                <option value="desc">Descending</option>
                            </select>
                        </div>

                        <button class="btn btn-primary" onclick="showAddProductPanel()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Add New Product
                        </button>
                    </div>
                </div>

                <div class="table-container">
                    <table class="products-table">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Category</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="products-table-body">
                            <!-- Products will be loaded via AJAX -->
                        </tbody>
                    </table>

                    <div class="pagination-container">
                        <div class="pagination-info">
                            <span id="pagination-info">Loading...</span>
                        </div>
                        <div class="pagination-controls">
                            <button id="prev-page" onclick="changePage(-1)" disabled>Previous</button>
                            <span id="page-numbers"></span>
                            <button id="next-page" onclick="changePage(1)" disabled>Next</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Removed Category Management tab as requested -->
        </div>

        <!-- Added backdrop div for modal panels -->
        <div id="popout-backdrop" class="popout-backdrop"></div>

        <!-- ---------------- POP-OUT PANELS ---------------- -->
        <!-- Enhanced edit user panel with proper form structure -->
        <div id="editUserPanel" class="popout-panel">
            <button class="close-popout" onclick="closePopout('editUserPanel')">&times;</button>
            <div class="popout-header">
                <h3 id="editUserPanelTitle">Edit User</h3>
            </div>
            <form id="user-form" onsubmit="saveUser(event)">
                <input type="hidden" id="user-id" />
                <div class="form-group">
                    <label for="user-name">Name:</label>
                    <input type="text" id="user-name" required />
                </div>
                <div class="form-group">
                    <label for="user-email">Email:</label>
                    <input type="email" id="user-email" required />
                </div>
                <div class="form-group">
                    <label for="user-role">Role:</label>
                    <select id="user-role" required>
                        <option value="member">Member</option>
                        <option value="staff">Staff</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closePopout('editUserPanel')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save User</button>
                </div>
            </form>
        </div>

        <!-- Enhanced edit product panel with proper form structure -->
        <div id="editProductPanel" class="popout-panel">
            <button class="close-popout" onclick="closePopout('editProductPanel')">&times;</button>
            <div class="popout-header">
                <h3 id="editProductPanelTitle">Edit Product</h3>
            </div>
            <form id="product-form" onsubmit="saveProduct(event)" enctype="multipart/form-data">
                <input type="hidden" id="product-id" />
                <div class="form-group">
                    <label for="product-name">Name:</label>
                    <input type="text" id="product-name" required />
                </div>
                <div class="form-group">
                    <label for="product-price">Price:</label>
                    <input type="number" id="product-price" step="0.01" min="0" required />
                </div>
                <div class="form-group">
                    <label for="product-description">Description:</label>
                    <textarea id="product-description" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label for="product-category">Category:</label>
                    <select id="product-category" required>
                        <option value="Pizza">Pizza</option>
                        <option value="Pasta">Pasta</option>
                        <option value="Seafood">Seafood</option>
                        <option value="Burgers">Burgers</option>
                        <option value="Beverages">Beverages</option>
                        <option value="Desserts">Desserts</option>
                        <option value="Specials">Specials</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Product Image:</label>
                    <div class="image-upload-container">
                        <div id="edit-image-dropzone" class="image-dropzone" onclick="document.getElementById('edit-product-image').click()">
                            <div class="dropzone-content">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                    <circle cx="8.5" cy="8.5" r="1.5" />
                                    <polyline points="21,15 16,10 5,21" />
                                </svg>
                                <p>Drag & drop an image here or click to browse</p>
                                <small>Supports JPG, PNG, GIF, WebP (max 5MB)</small>
                            </div>
                            <img id="edit-image-preview" class="image-preview" style="display: none;" />
                        </div>
                        <input type="file" id="edit-product-image" accept="image/*" style="display: none;" />
                        <div class="image-actions" style="display: none;">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="removeEditImage()">Remove Image</button>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closePopout('editProductPanel')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Product</button>
                </div>
            </form>
        </div>

        <!-- Enhanced order detail panel -->
        <div id="orderDetailPanel" class="popout-panel">
            <button class="close-popout" onclick="closePopout('orderDetailPanel')">&times;</button>
            <div class="popout-header">
                <h3>Order Details</h3>
            </div>
            <div id="orderDetailContent">
                <!-- Order details will be loaded here -->
            </div>
        </div>

        <!-- New user creation panel -->
        <div id="addUserPanel" class="popout-panel">
            <button class="close-popout" onclick="closePopout('addUserPanel')">&times;</button>
            <div class="popout-header">
                <h3>Add New User</h3>
            </div>
            <form id="add-user-form" onsubmit="addUser(event)">
                <div class="form-group">
                    <label for="new-user-id">User ID:</label>
                    <input type="text" id="new-user-id" required placeholder="Enter unique user ID" />
                </div>
                <div class="form-group">
                    <label for="new-user-name">Name:</label>
                    <input type="text" id="new-user-name" required placeholder="Enter full name" />
                </div>
                <div class="form-group">
                    <label for="new-user-email">Email:</label>
                    <input type="email" id="new-user-email" required placeholder="Enter email address" />
                </div>
                <div class="form-group">
                    <label for="new-user-password">Password:</label>
                    <input type="password" id="new-user-password" required placeholder="Enter password" minlength="6" />
                </div>
                <div class="form-group">
                    <label for="new-user-role">Role:</label>
                    <select id="new-user-role" required>
                        <option value="">Select role</option>
                        <option value="member">Member</option>
                        <option value="staff">Staff</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closePopout('addUserPanel')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create User</button>
                </div>
            </form>
        </div>

        <!-- New enhanced add product panel with drag-and-drop image upload -->
        <div id="addProductPanel" class="popout-panel">
            <button class="close-popout" onclick="closePopout('addProductPanel')">&times;</button>
            <div class="popout-header">
                <h3>Add New Product</h3>
            </div>
            <form id="add-product-form" onsubmit="addProduct(event)" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="add-product-name">Name:</label>
                    <input type="text" id="add-product-name" required placeholder="Enter product name" />
                </div>
                <div class="form-group">
                    <label for="add-product-price">Price:</label>
                    <input type="number" id="add-product-price" step="0.01" min="0" required placeholder="0.00" />
                </div>
                <div class="form-group">
                    <label for="add-product-description">Description:</label>
                    <textarea id="add-product-description" rows="3" placeholder="Enter product description (optional)"></textarea>
                </div>
                <div class="form-group">
                    <label for="add-product-category">Category:</label>
                    <select id="add-product-category" required>
                        <option value="">Select category</option>
                        <option value="Pizza">Pizza</option>
                        <option value="Pasta">Pasta</option>
                        <option value="Seafood">Seafood</option>
                        <option value="Burgers">Burgers</option>
                        <option value="Beverages">Beverages</option>
                        <option value="Desserts">Desserts</option>
                        <option value="Specials">Specials</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Product Image:</label>
                    <div class="image-upload-container">
                        <div id="add-image-dropzone" class="image-dropzone" onclick="document.getElementById('add-product-image').click()">
                            <div class="dropzone-content">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                    <circle cx="8.5" cy="8.5" r="1.5" />
                                    <polyline points="21,15 16,10 5,21" />
                                </svg>
                                <p>Drag & drop an image here or click to browse</p>
                                <small>Supports JPG, PNG, GIF, WebP (max 5MB)</small>
                            </div>
                            <img id="add-image-preview" class="image-preview" style="display: none;" />
                        </div>
                        <input type="file" id="add-product-image" accept="image/*" style="display: none;" />
                        <div class="image-actions" style="display: none;">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="removeAddImage()">Remove Image</button>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closePopout('addProductPanel')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Product</button>
                </div>
            </form>
        </div>
        @RenderBody()
    </main>

    <script src="~/js/staff.js" asp-append-version="true"></script>
    <script>
        // Auto-uppercase prefix input
        document.addEventListener('DOMContentLoaded', function() {
            const prefixInputs = document.querySelectorAll('#add-category-prefix, #edit-category-prefix');
            prefixInputs.forEach(input => {
                input.addEventListener('input', function() {
                    this.value = this.value.toUpperCase();
                });
            });

            showTab('orders');
        });
    </script>
</body>
</html>


