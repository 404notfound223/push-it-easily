@{
    var year = DateTime.Today.Year;
    var userId = Context.Session.GetString("UserId");
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
    var isLoggedIn = !string.IsNullOrEmpty(userId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] ?? "The Secret Restaurant"</title>

    <link rel="icon" type="image/jpeg" href="~/images/logoCSharp.jpg" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/js/app.js" asp-append-version="true" />

    @RenderSection("head", required: false)
</head>
<body>
    <header class="header-top">
        <div class="header-left">
            <button onclick="window.history.back()" class="btn btn-return" title="Return">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
                Return
            </button>
            <img src="~/images/logoCSharp.jpg" alt="Logo" />
            <h1 class="logo-caption">The Secret Restaurant</h1>
        </div>

        <form class="search-form" style="position: relative;">
            <!-- Added autocomplete="off" to disable browser autocomplete dropdown -->
            <input type="text" placeholder="Search menu items..." autocomplete="off" />
            <button type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </form>

        <div class="top-right">
            @if (isLoggedIn)
            {
                @if (userRole == "member")
                {
                    <div class="profile-container" style="position: relative;">
                        <button class="btn btn-profile" onclick="toggleProfileDropdown(event)">
                            Profile ▾
                        </button>
                        <div class="profile-dropdown" id="profileDropdown">
                            <button onclick="showProfile()" class="btn btn-primary">View Profile</button>
                            <button onclick="logout()" class="btn btn-primary">Logout</button>
                            <button onclick="viewOrderHistory()" class="btn btn-primary">Order History</button>
                        </div>
                    </div>
                }

                @if (userRole == "admin" || userRole == "staff")
                {
                    <button onclick="window.location.href='/Staff/Dashboard'" class="btn btn-move" title="Staff Dashboard">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9,22 9,12 15,12 15,22"></polyline>
                        </svg>
                        Dashboard
                    </button>
                }

                <button onclick="logout()" class="btn btn-logout" title="Logout">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16,17 21,12 16,7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Logout
                </button>
            }
            else
            {
                <button onclick="window.location.href='/Login/Login'" class="btn btn-login">Login</button>
                <button onclick="window.location.href='/Login/Register'" class="btn btn-register">Register</button>
            }
        </div>
    </header>

    <div class="container">
        <nav class="sidebar">
            <div class="sidebar-item" onclick="navigateTo('/Menu/All')">All</div>
            <div class="sidebar-item" onclick="toggleDropdown(this)">
                Mains
                <span class="arrow">▶</span>
            </div>
            <div class="dropdown">
                <div class="dropdown-item" onclick="navigateTo('/Menu/Specials')">Chef's Specials</div>
                <div class="dropdown-item" onclick="navigateTo('/Menu/Pizza')">Pizza</div>
                <div class="dropdown-item" onclick="navigateTo('/Menu/Pasta')">Pasta</div>
                <div class="dropdown-item" onclick="navigateTo('/Menu/Seafood')">Seafood</div>
                <div class="dropdown-item" onclick="navigateTo('/Menu/Burgers')">Burger</div>
            </div>
            <div class="sidebar-item" onclick="navigateTo('/Menu/Beverages')">Beverages</div>
            <div class="sidebar-item" onclick="navigateTo('/Menu/Desserts')">Desserts</div>
        </nav>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <div class="btm-right">
        <button onclick="window.location.href='/Order/ViewOrder'" class="btn btn-view-order" title="View Order">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-4"></path>
                <polyline points="9,11 12,14 15,11"></polyline>
                <line x1="12" y1="2" x2="12" y2="14"></line>
            </svg>
            View Order
            <span id="order-count" class="order-badge">0</span>
        </button>
    </div>

    <footer>
        Developed by <b>The Secret Restaurant</b> &middot; © @year
    </footer>

    <div id="profile-modal" class="modal" style="display: none;">
        <div class="modal-content">
            <span class="close" onclick="closeProfile()">&times;</span>
            <h2>User Profile</h2>
            <div class="profile-info">
                <p>
                    <strong>Name:</strong>
                    <span id="username-display">@userName</span>
                    <button id="edit-username-btn" onclick="editUsername()" class="btn btn-small">Edit</button>
                </p>
                <div id="username-edit" style="display: none;">
                    <input type="text" id="new-username" value="@userName" />
                    <button onclick="saveUsername()" class="btn btn-small btn-primary">Save</button>
                    <button onclick="cancelEditUsername()" class="btn btn-small btn-secondary">Cancel</button>
                </div>
                <p><strong>Role:</strong> @userRole</p>
                <p><strong>User ID:</strong> @userId</p>
            </div>
            <div class="profile-actions">
                <button onclick="closeProfile()" class="btn btn-secondary">Close</button>
                <button onclick="resetPassword()" class="btn btn-primary">Reset Password</button>
            </div>
        </div>
    </div>

    <!-- Added forgot password modal for password reset functionality -->
    <div id="forgot-password-modal" class="modal" style="display: none;">
        <div class="modal-content">
            <span class="close" onclick="closeForgotPassword()">&times;</span>
            <h2>Reset Password</h2>
            <div id="forgot-message"></div>

            <div id="password-reset-form">
                <div class="form-group">
                    <label for="current-password">Current Password:</label>
                    <input type="password" id="current-password" required />
                </div>
                <div class="form-group">
                    <label for="new-password">New Password:</label>
                    <input type="password" id="new-password" required />
                </div>
                <div class="form-group">
                    <label for="confirm-password">Confirm New Password:</label>
                    <input type="password" id="confirm-password" required />
                </div>
                <div class="form-actions">
                    <button onclick="closeForgotPassword()" class="btn btn-secondary">Cancel</button>
                    <button onclick="changePassword()" class="btn btn-primary">Change Password</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/order.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
    @RenderSection("foot", required: false)
</body>
</html>
