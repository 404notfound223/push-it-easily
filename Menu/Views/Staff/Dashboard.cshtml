@model StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />

<div class="staff-dashboard">
    <div class="dashboard-header">
        <h1>Staff Dashboard</h1>
        <div class="role-badge role-@Model.UserRole.ToLower()">@Model.UserRole.ToUpper()</div>
    </div>

    <div class="dashboard-tabs">
        <button class="tab-button active" onclick="showTab('orders', event)">Order Management</button>
        @if (Model.UserRole?.ToLower() == "admin")
        {
            <button class="tab-button" onclick="showTab('users', event)">User Management</button>
        }
        <button class="tab-button" onclick="showTab('products', event)">Product Management</button>
    </div>

    <!-- ---------------- ORDER MANAGEMENT TAB ---------------- -->
    <div id="orders-tab" class="tab-content active">
        <table class="orders-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.OrderId[..Math.Min(order.OrderId.Length, 40)].ToUpper()</td>
                        <td>@(order.User?.Name ?? "Guest")</td>
                        <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>$@order.TotalAmount.ToString("F2")</td>
                        <td>
                            <select class="status-select" onchange="updateOrderStatus('@order.OrderId', this.value)">
                                <option value="Pending" selected="@(order.Status == "Pending")">Pending</option>
                                <option value="Preparing" selected="@(order.Status == "Preparing")">Preparing</option>
                                <option value="Ready" selected="@(order.Status == "Ready")">Ready</option>
                                <option value="Completed" selected="@(order.Status == "Completed")">Completed</option>
                                <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                            </select>
                        </td>
                        <td><button class="btn btn-sm btn-info" onclick="openPopout('orderDetailPanel','@order.OrderId')">View Order</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ---------------- USER MANAGEMENT TAB ---------------- -->
    @if (Model.UserRole?.ToLower() == "admin")
    {
        <div id="users-tab" class="tab-content">
            <table class="users-table">
                <thead><tr><th>User ID</th><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserId[..Math.Min(user.UserId.Length, 8)].ToUpper()</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td><span class="role-badge role-@user.Role.ToLower()">@user.Role</span></td>
                            <td>
                                <button class="btn btn-sm btn-warning" onclick="openPopout('editUserPanel','@user.UserId')">Edit</button>
                                <button class="btn btn-sm btn-danger" onclick="deleteUser('@user.UserId')">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ---------------- PRODUCT MANAGEMENT TAB ---------------- -->
    <div id="products-tab" class="tab-content">
        <table class="products-table">
            <thead><tr><th>Product ID</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Id[..Math.Min(product.Id.Length, 8)].ToUpper()</td>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td>$@product.Price.ToString("F2")</td>
                        <td>@product.Stock</td>
                        <td>
                            <button class="btn btn-sm btn-warning" onclick="openPopout('editProductPanel','@product.Id')">Edit</button>
                            <button class="btn btn-sm btn-danger" onclick="deleteProduct('@product.Id')">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ---------------- POP-OUT PANELS ---------------- -->
<div id="editUserPanel" class="popout-panel">
    <button class="close-popout" data-close="editUserPanel">&times;</button>
</div>
<div id="editProductPanel" class="popout-panel">
    <button class="close-popout" data-close="editProductPanel">&times;</button>
</div>
<div id="orderDetailPanel" class="popout-panel">
    <button class="close-popout" data-close="orderDetailPanel">&times;</button>
</div>

<script>
    function showTab(tab, e){
        document.querySelectorAll('.tab-button').forEach(b=>b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));
        document.getElementById(tab+'-tab').classList.add('active');
        e.currentTarget.classList.add('active');
    }
    document.querySelectorAll('.close-popout').forEach(b=>{
        b.addEventListener('click',()=>{ document.getElementById(b.dataset.close).classList.remove('open'); });
    });
    function openPopout(panelId,id=null){ const p=document.getElementById(panelId); if(id)p.dataset.id=id; p.classList.add('open'); }
</script>
