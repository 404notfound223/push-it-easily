@model StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />

<div class="staff-dashboard">
    <div class="dashboard-header">
        <h1>Staff Dashboard</h1>
        <div class="role-badge role-@Model.UserRole.ToLower()">@Model.UserRole.ToUpper()</div>
    </div>

    <div class="dashboard-tabs">
        <button class="tab-button active" onclick="showTab('orders')">Order Management</button>
        @if (Model.UserRole?.ToLower() == "admin")
        {
            <button class="tab-button" onclick="showTab('users')">User Management</button>
        }
    </div>

    @* ---------------- ORDER MANAGEMENT TAB ---------------- *@
    <div id="orders-tab" class="tab-content active">
        <div class="section-header">
            <h2>Customer Orders</h2>
            <div class="order-stats">
                <div class="stat-card">
                    <span class="stat-number">@Model.Orders.Count(o => o.Status == "Pending")</span>
                    <span class="stat-label">Pending</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@Model.Orders.Count(o => o.Status == "Preparing")</span>
                    <span class="stat-label">Preparing</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@Model.Orders.Count(o => o.Status == "Ready")</span>
                    <span class="stat-label">Ready</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@Model.Orders.Count(o => o.Status == "Completed")</span>
                    <span class="stat-label">Completed</span>
                </div>
            </div>
        </div>

        <div class="orders-table-container">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr class="order-row" data-order-id="@order.OrderId">
                            <td>@order.OrderId.Substring(0, Math.Min(8, order.OrderId.Length)).ToUpper()</td>
                            <td>@(order.User?.Name ?? "Guest")</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>$@order.TotalAmount.ToString("F2")</td>
                            <td>
                                <select class="status-select"
                                        onchange="updateOrderStatus('@order.OrderId', this.value)"
                                        asp-for="@order.Status"
                                        asp-items="@(new SelectList(new[] { "Pending", "Preparing", "Ready", "Completed", "Cancelled" }, order.Status))">
                                </select>
                            </td>
                            <td>
                                <button onclick="openPopout('orderDetailPanel', '@order.OrderId')"
                                        class="btn btn-sm btn-info">
                                    View Order
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ---------------- USER MANAGEMENT TAB (ADMIN ONLY) ---------------- *@
    @if (Model.UserRole?.ToLower() == "admin")
    {
        <div id="users-tab" class="tab-content">
            <div class="section-header">
                <h2>User Management</h2>
                <button onclick="openPopout('editUserPanel')" class="btn btn-primary">Add New User</button>
            </div>

            <div class="users-table-container">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr data-user-id="@user.UserId">
                                <td>@user.UserId.Substring(0, Math.Min(8, user.UserId.Length)).ToUpper()</td>
                                <td>@user.Name</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="role-badge role-@user.Role.ToLower()">@user.Role</span>
                                </td>
                                <td>
                                    <!-- ✅ Edit User -->
                                    <button onclick="openPopout('editUserPanel', '@user.UserId')"
                                            class="btn btn-sm btn-warning">
                                        Edit User
                                    </button>

                                    <!-- ✅ View Orders for this User -->
                                    <button onclick="openPopout('orderDetailPanel', '@user.UserId')"
                                            class="btn btn-sm btn-info">
                                        View Orders
                                    </button>

                                    <!-- ✅ Delete User -->
                                    <button onclick="deleteUser('@user.UserId')"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


@* ---------------- POP-OUT PANELS ---------------- *@

<!-- Edit User Panel -->
<div id="editUserPanel" class="popout-panel">
    <button class="close-popout" data-close="editUserPanel">&times;</button>
    <div class="popout-header">
        <h3>Edit User</h3>
    </div>
    <div class="popout-body">
        <form id="editUserForm">
            <input type="hidden" id="user-id" />
            <label>Name</label>
            <input type="text" id="user-name" placeholder="Enter name" />

            <label>Email</label>
            <input type="email" id="user-email" placeholder="Enter email" />

            <label>Role</label>
            <select id="user-role">
                <option value="member">Member</option>
                <option value="staff">Staff</option>
                <option value="admin">Admin</option>
            </select>

            <div class="form-actions">
                <button type="button" onclick="saveUser()" class="btn-open-popout">Save</button>
                <button type="button" class="btn btn-secondary" data-close="editUserPanel">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Order Detail Panel -->
<div id="orderDetailPanel" class="popout-panel">
    <button class="close-popout" data-close="orderDetailPanel">&times;</button>
    <div class="popout-header">
        <h3>Order Details</h3>
    </div>
    <div class="popout-body" id="order-details-content">
        <!-- Filled dynamically from staff.js -->
    </div>
</div>

<script src="~/js/staff.js" defer></script>
