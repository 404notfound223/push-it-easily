@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" />
</head>
<body>
    <div class="login-container">
        <div class="logo-container">
            <img src="/Images/logoCSharp.jpg" alt="The Secret Restaurant" class="logo" />
        </div>

        <h1 class="form-title">Sign In</h1>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="success-message">
                @ViewBag.Success
            </div>
        }

        <form method="post" asp-action="Login">
            <div class="form-group">
                <i class="fas fa-envelope form-icon"></i>
                <input type="email" name="email" id="email" class="form-control" placeholder="Email" required>
                <label for="email" class="form-label"></label>
            </div>

            <div class="form-group">
                <i class="fas fa-lock form-icon"></i>
                <input type="password" name="password" id="password" class="form-control" placeholder="Password" required>
                <label for="password" class="form-label"></label>
            </div>

            <input type="submit" class="btn" value="Sign In">
        </form>

        <div class="links">
            <p>Don't have an account?</p>
            <a asp-action="Register" asp-controller="Login">Register</a>
        </div>

        @* <div class="links">
            <a href="#" onclick="showForgotPassword()">Forgot Password?</a>
        </div> *@

        <div class="links">
            <p>Customer Ordering Menu. </p>
            <a asp-action="All" asp-controller="Menu">Guest Menu</a>
        </div>
    </div>

    @* <div id="forgot-password-modal" class="modal" style="display: none;">
        <div class="modal-content">
            <span class="close" onclick="closeForgotPassword()">&times;</span>
            <h2>Reset Password</h2>
            <div id="forgot-step-1">
                <p>Enter your email address to receive a password reset code:</p>
                <input type="email" id="forgot-email" placeholder="Enter your email" />
                <button onclick="sendResetCode()" class="btn btn-primary">Send Reset Code</button>
            </div>
            <div id="forgot-step-2" style="display: none;">
                <p>Enter the reset code sent to your email:</p>
                <input type="text" id="reset-code" placeholder="Enter reset code" />
                <p>Enter your new password:</p>
                <input type="password" id="new-password" placeholder="New password" />
                <p>Confirm your new password:</p>
                <input type="password" id="confirm-password" placeholder="Confirm new password" />
                <button onclick="resetPasswordWithCode()" class="btn btn-primary">Reset Password</button>
            </div>
            <div id="forgot-message"></div>
        </div>
    </div> *@

    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
</body>
</html>