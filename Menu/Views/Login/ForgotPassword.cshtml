@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Forgot Password</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        .step-container {
            display: none;
        }
        .step-container.active {
            display: block;
        }
        .step-title {
            font-size: 1.2rem;
            margin-bottom: 1rem;
            text-align: center;
            color: #333;
        }
        .step-description {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #666;
        }
        .btn-secondary {
            background: #6c757d;
            color: white;
            margin-right: 10px;
        }
        .btn-secondary:hover {
            background: #5a6268;
        }
        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }
        .button-group .btn {
            flex: 1;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo-container">
            <img src="/Images/logoCSharp.jpg" alt="The Secret Restaurant" class="logo" />
        </div>

        <h1 class="form-title">Reset Password</h1>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="success-message">
                @ViewBag.Success
            </div>
        }

        <!-- Step 1: Enter Email -->
        <div id="step-1" class="step-container active">
            <div class="step-title">Enter Your Email</div>
            <div class="step-description">We'll send you a verification code to reset your password</div>

            <div class="form-group">
                <i class="fas fa-envelope form-icon"></i>
                <input type="email" id="reset-email" class="form-control" placeholder="Enter your email" required>
                <label for="reset-email" class="form-label"></label>
            </div>

            <div class="button-group">
                <button type="button" class="btn btn-secondary" onclick="returnToLogin()">Return to Login</button>
                <button type="button" class="btn" onclick="sendResetCode()">Send Code</button>
            </div>
        </div>

        <!-- Step 2: Enter Code and New Password -->
        <div id="step-2" class="step-container">
            <div class="step-title">Reset Your Password</div>
            <div class="step-description">Enter the verification code sent to your email and your new password</div>

            <form method="post" asp-action="ResetPassword" id="resetPasswordForm">
                <input type="hidden" id="hidden-email" name="email" />

                <div class="form-group">
                    <i class="fas fa-key form-icon"></i>
                    <input type="text" name="resetCode" id="reset-code" class="form-control" placeholder="Verification Code" required maxlength="6" minlength="6">
                    <label for="reset-code" class="form-label"></label>
                </div>

                <div class="form-group">
                    <i class="fas fa-lock form-icon"></i>
                    <input type="password" name="newPassword" id="new-password" class="form-control" placeholder="New Password" required>
                    <label for="new-password" class="form-label"></label>
                    <div class="password-requirements">Must be 8-16 characters</div>
                </div>

                <div class="form-group">
                    <i class="fas fa-lock form-icon"></i>
                    <input type="password" id="confirm-new-password" class="form-control" placeholder="Retype New Password" required>
                    <label for="confirm-new-password" class="form-label"></label>
                </div>

                <div id="passwordError" class="error-message" style="display:none;"></div>

                <div class="button-group">
                    <button type="button" class="btn btn-secondary" onclick="returnToLogin()">Return to Login</button>
                    <button type="submit" class="btn">Reset Password</button>
                </div>
            </form>
        </div>

        <div id="reset-message" class="success-message" style="display:none;"></div>
    </div>

    <script>
        function returnToLogin() {
            window.location.href = '@Url.Action("Login", "Login")';
        }

        function sendResetCode() {
            const email = document.getElementById('reset-email').value;
            if (!email) {
                alert('Please enter your email address.');
                return;
            }

            // Show loading state
            const sendButton = event.target;
            const originalText = sendButton.textContent;
            sendButton.textContent = 'Sending...';
            sendButton.disabled = true;

            fetch('/Login/SendPasswordResetCode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            })
            .then(response => {
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    return response.json();
                } else {
                    return response.text().then(text => { throw new Error(text); });
                }
            })
            .then(data => {
                if (data.success) {
                    // Show success message
                    const messageDiv = document.getElementById('reset-message');
                    messageDiv.textContent = data.message;
                    messageDiv.style.display = 'block';

                    // Move to step 2
                    document.getElementById('step-1').classList.remove('active');
                    document.getElementById('step-2').classList.add('active');

                    // Set hidden email field
                    document.getElementById('hidden-email').value = email;
                } else {
                    alert(data.error || 'Failed to send reset code.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Something went wrong. Please try again.');
            })
            .finally(() => {
                // Reset button state
                sendButton.textContent = originalText;
                sendButton.disabled = false;
            });
        }

        // Password validation
        document.addEventListener('DOMContentLoaded', function() {
            const resetForm = document.getElementById('resetPasswordForm');
            if (resetForm) {
                resetForm.addEventListener('submit', function(e) {
                    const newPassword = document.getElementById('new-password').value;
                    const confirmPassword = document.getElementById('confirm-new-password').value;
                    const errorDiv = document.getElementById('passwordError');

                    errorDiv.style.display = 'none';
                    errorDiv.textContent = '';

                    if (newPassword.length < 8 || newPassword.length > 16) {
                        errorDiv.textContent = 'Password must be between 8 and 16 characters.';
                        errorDiv.style.display = 'block';
                        e.preventDefault();
                        return;
                    }

                    if (newPassword !== confirmPassword) {
                        errorDiv.textContent = 'Passwords do not match.';
                        errorDiv.style.display = 'block';
                        e.preventDefault();
                        return;
                    }
                });
            }
        });
    </script>
</body>
</html>
